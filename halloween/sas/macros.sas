%macro daily_frame(in=, out=, last_date=);
    proc sql noprint;
        select min(report_begin_date) into :first_day trimmed from &in;
    quit;
    data &out;
        do date = &first_day to &last_date;
            year = year(date);
            in_season = (-1 <= mdy(10, 31, year) - date <= 62);
            dth = ifn(in_season, mdy(10, 31, year) - date, 0);
            dth2 = dth * dth;
            output;
        end;
        format date yymmdd10.;
    run;
    data &out;
        merge &out(in=a) &in(keep=week_mid lp rename=(week_mid=date));
        by date;
        if a;
    run;
%mend;
