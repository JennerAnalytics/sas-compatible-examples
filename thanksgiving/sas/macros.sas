%macro daily_frame(in=, out=, last_date=);
    proc sql noprint;
        select min(report_begin_date) format=8. into :first_day trimmed from &in;
    quit;
    data &out;
        do date = &first_day to &last_date;
            year = year(date);
            tday = nwkdom(4, 5, 11, year);
            in_season = (0 <= tday - date <= &max_dtt + 3);
            dtt = ifn(in_season, tday - date, 0);
            dtt2 = dtt * dtt;
            output;
        end;
        format date tday yymmdd10.;
    run;
    data &out;
        merge &out(in=a) &in(keep=week_mid lp rename=(week_mid=date));
        by date;
        if a;
    run;
%mend;
